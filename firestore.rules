rules_version = '2';
// Paste into Firebase console: Firestore Database, Rules, Publish.
// Each signed-in person can read and write only their own users/{uid} record and its tracker. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(["profile", "profileAt"])
        && request.resource.data.profile is map
        && request.resource.data.profileAt is map;

      match /tracker/{programId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && programId.size() <= 120
          && request.resource.data.keys().hasOnly(["status", "statusAt", "notes", "notesAt", "decision", "decidedOn", "textHash", "decisionAt", "name", "state"])
          && request.resource.data.status is string && request.resource.data.status.size() <= 40
          && request.resource.data.notes is string && request.resource.data.notes.size() <= 20000
          && request.resource.data.decision in ["", "shortlist", "excluded"];
      }
    }
  }
}
